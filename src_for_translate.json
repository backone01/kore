 "vandap": [
  {
   "k": "1",
   "ko": "이름이 뭐 예요?",
   "a": "제 이름은 (000)입니다."
  },
  {
   "k": "2",
   "ko": "나이가 어떻게 되세요?",
   "a": "저는 (서른 여섯) 살입니다."
  },
  {
   "k": "3",
   "ko": "생일이 언제예요?",
   "a": "(천 구백 팔십 육)년 (시)월 (이)일입니다."
  },
  {
   "k": "4",
   "ko": "고향이 어디예요?",
   "a": "제 고향은 (베트남 하남)입니다."
  },
  {
   "k": "5",
   "ko": "가족은 몇명이에요?",
   "a": "우리 가족은 모두 (세)명입니다."
  },
  {
   "k": "6",
   "ko": "누구누구입니까? 누구누구예요?",
   "a": "(어머니, 누나)하고 저입니다."
  },
  {
   "k": "7",
   "ko": "부모님이 계세요?",
   "a": "네, 계십니다/아니요, 돌아가셨습니다."
  },
  {
   "k": "8",
   "ko": "형제가 몇명이 있습니까?",
   "a": "네, (두명)이 있습니다. (형 하나)하고 저입니다."
  },
  {
   "k": "9",
   "ko": "결혼했어요?",
   "a": "네, 결혼했습니다./아니요, 결혼 안했습니다."
  },
  {
   "k": "10",
   "ko": "아이가 있어요?",
   "a": "네, (아들 하나하고 딸 하나) 있습니다."
  },
  {
   "k": "11",
   "ko": "키가 얼마예요?",
   "a": "(백육십오) 센티미터입니다."
  },
  {
   "k": "12",
   "ko": "몸 무게는 얼마나 되세요?",
   "a": "(오십오) 킬로그램입니다."
  },
  {
   "k": "13",
   "ko": "오늘 무슨 요일이에요?",
   "a": "오늘은 토요일입니다."
  },
  {
   "k": "14",
   "ko": "어제 무슨 요일이에요?",
   "a": "어제가 금요일입니다."
  },
  {
   "k": "15",
   "ko": "내일 무슨 요일이에요?",
   "a": "내일은 일요일입니다."
  },
  {
   "k": "16",
   "ko": "오늘 몇월 며칠이에요?",
   "a": "유월 이십사일입니다."
  },
  {
   "k": "17",
   "ko": "내일 몇월 며칠이에요?",
   "a": "유월 이십오일입니다."
  },
  {
   "k": "18",
   "ko": "어제 몇월 며칠이에요?",
   "a": "유월 이십삼일입니다."
  },
  {
   "k": "19",
   "ko": "한국에 왜 가고 싶어요?",
   "a": "문화 체험을 하고 돈도 벌려고 합니다."
  },
  {
   "k": "21",
   "ko": "요즘 무슨 일을 하세요?",
   "a": "전자 제품 조립작업을 하고 있습니다."
  },
  {
   "k": "22",
   "ko": "한국말을 잘 할수 있어요?",
   "a": "아니요. 기초대화만 할수 있습니다."
  },
  {
   "k": "23",
   "ko": "무엇을 타고 왔어요?",
   "a": "(오토바이, 택시, 자동차)를 타고 왔습니다."
  },
  {
   "k": "24",
   "ko": "여기까지 얼마나 걸렸어요?",
   "a": "여기까지 한 시간 반 정도 걸렸습니다."
  },
  {
   "k": "25",
   "ko": "전에 무슨 일을 했어요?",
   "a": "(조선 선박)을 한 적이 있습니다."
  },
  {
   "k": "26",
   "ko": "왜 우리가 당신을 고용해야 합니까?",
   "a": "저는 빠른 학습자이고 책임감이 있는 사람입니다."
  },
  {
   "k": "27",
   "ko": "외국에 가 본적이 있어요?",
   "a": "한국에 가본적이 있습니다. (가본적이 없습니다.)"
  },
  {
   "k": "28",
   "ko": "무슨 운동을 좋아합니까?",
   "a": "저는 배드민턴을 좋아합니다."
  },
  {
   "k": "29",
   "ko": "취미가 뭐예요?",
   "a": "제 취미는 운동입니다."
  },
  {
