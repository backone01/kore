 "chithihanhdong": {
  "sxct_001": {
   "ko": "다음 작업 지시를 잘 듣고 지시대로 정확하게 수행하세요.",
   "type": "su-dung-cong-cu",
   "id": 1,
   "audio_id": "001"
  },
  "sxct_002": {
   "ko": "안전모와 안전장갑을 착용하세요.",
   "type": "su-dung-cong-cu",
   "id": 2,
   "audio_id": "002"
  },
  "sxct_003": {
   "ko": "망치와 톱을 가져오세요.",
   "type": "su-dung-cong-cu",
   "id": 3,
   "audio_id": "003"
  },
  "sxct_004": {
   "ko": "망치로 나무판에 못을 박아 보세요.",
   "type": "su-dung-cong-cu",
   "id": 4,
   "audio_id": "004"
  },
  "sxct_005": {
   "ko": "톱으로 나무를 잘라 보세요.",
   "type": "su-dung-cong-cu",
   "id": 5,
   "audio_id": "005"
  },
  "sxct_006": {
   "ko": "망치와 톱을 공구함에 넣으세요.",
   "type": "su-dung-cong-cu",
   "id": 6,
   "audio_id": "006"
  },
  "sxct_007": {
   "ko": "안전모를 착용하세요.",
   "type": "su-dung-cong-cu",
   "id": 7,
   "audio_id": "007"
  },
  "sxct_008": {
   "ko": "줄자와 전기드릴을 가져오세요.",
   "type": "su-dung-cong-cu",
   "id": 8,
   "audio_id": "008"
  },
  "sxct_009": {
   "ko": "줄자로 나무판의 길이를 재 보세요.",
   "type": "su-dung-cong-cu",
   "id": 9,
   "audio_id": "009"
  },
  "sxct_010": {
   "ko": "표시된 곳에 전기드릴로 나사못을 박아 보세요.",
   "type": "su-dung-cong-cu",
   "id": 10,
   "audio_id": "010"
  },
  "ngu_1": {
   "ko": "밧줄을 묶는 동작을 해 보세요.",
   "type": "su-dung-cong-cu",
   "id": 1,
   "audio_id": "1"
  },
  "ngu_2": {
   "ko": "구명조끼를 입는 동작을 해 보세요.",
   "type": "su-dung-cong-cu",
   "id": 2,
   "audio_id": "2"
  },
  "ngu_3": {
   "ko": "그물을 끌어올리는 동작을 해 보세요.",
   "type": "su-dung-cong-cu",
   "id": 3,
   "audio_id": "3"
  },
  "ngu_4": {
   "ko": "그물을 정리하는 동작을 해 보세요.",
   "type": "su-dung-cong-cu",
   "id": 4,
   "audio_id": "4"
  },
  "ngu_5": {
   "ko": "그물을 세척하는 동작을 해 보세요.",
   "type": "su-dung-cong-cu",
   "id": 5,
   "audio_id": "5"
  },
  "lam_1": {
   "ko": "예초기를 사용하는 동작을 해 보세요.",
   "type": "su-dung-cong-cu",
   "id": 1,
   "audio_id": "1"
  },
  "lam_2": {
   "ko": "낫으로 잡초를 베는 동작을 해 보세요.",
   "type": "su-dung-cong-cu",
   "id": 2,
   "audio_id": "2"
  },
  "lam_3": {
   "ko": "도끼로 나무를 자르는 동작을 해 보세요.",
   "type": "su-dung-cong-cu",
   "id": 3,
   "audio_id": "3"
  },
  "lam_4": {
   "ko": "망치로 못을 박는 동작을 해 보세요.",
   "type": "su-dung-cong-cu",
   "id": 4,
   "audio_id": "4"
  },
  "lam_5": {
   "ko": "망치로 못을 빼는 동작을 해 보세요.",
   "type": "su-dung-cong-cu",
   "id": 5,
   "audio_id": "5"
  },
  "lam_6": {
   "ko": "삽으로 땅을 파는 동작을 해 보세요.",
   "type": "su-dung-cong-cu",
   "id": 6,
   "audio_id": "6"
  },
  "lam_7": {
   "ko": "밧줄을 묶는 동작을 해 보세요.",
   "type": "su-dung-cong-cu",
   "id": 7,
   "audio_id": "7"
  },
  "lam_8": {
   "ko": "저울로 무게를 재는 동작을 해 보세요.",
   "type": "su-dung-cong-cu",
   "id": 8,
   "audio_id": "8"
  },
  "dichvu_1": {
   "ko": "광택제를 사용해서 바닥을 닦아 주세요.",
   "type": "su-dung-cong-cu",
   "id": 1,
   "audio_id": "1"
  },
  "dichvu_2": {
   "ko": "버니셔로 바닥을 광택 내세요.",
   "type": "su-dung-cong-cu",
   "id": 2,
   "audio_id": "2"
  },
  "dichvu_3": {
   "ko": "세척제로 싱크대를 청소하세요.",
   "type": "su-dung-cong-cu",
   "id": 3,
   "audio_id": "3"
  },
  "dichvu_4": {
   "ko": "소독제로 손잡이를 소독하세요.",
   "type": "su-dung-cong-cu",
   "id": 4,
   "audio_id": "4"
  },
  "dichvu_5": {
   "ko": "제거제로 얼룩을 제거하세요.",
   "type": "su-dung-cong-cu",
   "id": 5,
   "audio_id": "5"
  },
  "dichvu_6": {
   "ko": "주방카트로 식기를 옮기세요.",
   "type": "su-dung-cong-cu",
   "id": 6,
   "audio_id": "6"
  },
  "dichvu_7": {
   "ko": "진공청소기로 바닥을 청소하세요.",
   "type": "su-dung-cong-cu",
   "id": 7,
   "audio_id": "7"
  },
  "dichvu_8": {
   "ko": "하우스키핑카트를 정리해 주세요.",
   "type": "su-dung-cong-cu",
   "id": 8,
   "audio_id": "8"
  },
  "dichvu_9": {
   "ko": "국자로 국을 퍼 주세요.",
   "type": "su-dung-cong-cu",
   "id": 9,
   "audio_id": "9"
  },
  "dichvu_10": {
   "ko": "냄비를 닦는 행동을 해 보세요.",
   "type": "su-dung-cong-cu",
   "id": 10,
   "audio_id": "10"
  }
 },
